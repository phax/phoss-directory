<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.helger</groupId>
    <artifactId>phoss-directory-parent-pom</artifactId>
    <version>0.17.4-SNAPSHOT</version>
  </parent>
  <artifactId>phoss-directory-indexer-conformance</artifactId>
  <packaging>jar</packaging>
  <name>phoss-directory-indexer-conformance</name>
  <description>The engine independent conformance test suite for implementations of the Peppol Directory search index</description>
  <url>https://github.com/phax/phoss-directory/phoss-directory-indexer-conformance</url>
  <inceptionYear>2026</inceptionYear>

  <properties>
    <java.version>${java.version.server}</java.version>
  </properties>
  
  <licenses>
    <license>
      <name>Apache 2</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  
  <organization>
    <name>Philip Helger</name>
    <url>https://www.helger.com</url>
  </organization>
  
  <developers>
    <developer>
      <id>philip</id>
      <name>Philip Helger</name>
      <email>ph(at)helger.com</email>
      <url>https://www.helger.com</url>
    </developer>
  </developers>
  
  <dependencies>
    <dependency>
      <groupId>com.helger</groupId>
      <artifactId>phoss-directory-indexer</artifactId>
    </dependency>
    <!--
      This module contains test base classes only, so JUnit is a regular compile scope dependency
      and not a test scope dependency
    -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>compile</scope>
    </dependency>
    <!-- Required by PDIndexerTestRule to route the JUL logging of the tests to SLF4J -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>jul-to-slf4j</artifactId>
    </dependency>
    <!--
      PDIndexerTestRule creates a mock web scope, so the Servlet API is needed at runtime. Unlike
      in the other modules this is not a "provided" dependency, because this module is only ever
      used in the test scope, where nobody else provides it.
    -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
    </dependency>
  </dependencies>
  
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>**/*.properties</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>**/*.properties</exclude>
        </excludes>
      </resource>
    </resources>
  </build>
</project>
